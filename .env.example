DATABASE_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_AUDIT_MODEL=gpt-4.1-mini
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
FORM_SUBMIT_ENABLED=false
FORM_SUBMIT_FROM_EMAIL=callaudtix@gmail.com

# Audio uploads. Leave AUDIO_STORAGE empty to auto-select:
# Vercel Blob when BLOB_READ_WRITE_TOKEN is set, S3 when the bucket credentials are set,
# local disk outside Vercel, and mock mode (sample audio, no filesystem write) as the fallback.
AUDIO_STORAGE=
BLOB_READ_WRITE_TOKEN=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=
